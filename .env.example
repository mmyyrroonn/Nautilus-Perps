# copy to .env and fill; .env is gitignored
#
# WARNING - MAINNET.  Nothing in this file authorises a mainnet order.  src/maker_live.py
# refuses `--live --env mainnet` without `--confirm-mainnet`, and per CLAUDE.md the user must
# ALSO say the go-ahead in the current conversation before anyone runs it.  Position and loss
# limits live in config/limits.toml; the hard caps behind them are module constants in
# src/live_limits.py that no config file, flag or environment variable can widen.
# src/maker_live.py --paper needs no credentials at all: it reads public feeds only.
HYPERLIQUID_PRIVATE_KEY=
HYPERLIQUID_TESTNET=true
# Lighter execution (2.0.0rc4 adapter reads exactly these names; mainnet namespace).
# The API key is created once at https://app.lighter.xyz/apikeys with an L1 signature;
# use key index 4..254, the secret is a 40-byte hex string shown only once.
LIGHTER_ACCOUNT_INDEX=
LIGHTER_API_KEY_INDEX=
LIGHTER_API_SECRET=
# Testnet uses a separate namespace (the adapter selects the environment in code, there is
# no LIGHTER_TESTNET switch).  `maker_live.py --env testnet --live` reads exactly these:
LIGHTER_TESTNET_ACCOUNT_INDEX=
LIGHTER_TESTNET_API_KEY_INDEX=
LIGHTER_TESTNET_API_SECRET=
# Aster EIP-712 API wallet (execution only; read-only market data needs none)
ASTER_USER_ADDRESS=
ASTER_SIGNER_ADDRESS=
ASTER_SIGNER_PRIVATE_KEY=
ASTER_TESTNET=true
# Aster MAINNET API wallet - a separate wallet from the testnet one above; keep the
# ASTER_* trio pointing at testnet so the testnet probe keeps working. Read-only checks
# (commissionRate / balance / positionRisk) use these; nothing places mainnet orders
# unless the user says so in the current conversation.
ASTER_MAINNET_USER_ADDRESS=
ASTER_MAINNET_SIGNER_ADDRESS=
ASTER_MAINNET_SIGNER_PRIVATE_KEY=
# Ondo Perps SANDBOX. The adapter reads exactly the first two names from the environment and
# errors when either is missing rather than falling back to another account; the account id is
# a required config field the app passes in. Production names a separate namespace (below) with
# no fallback in either direction, and this file authorises no mainnet order.
ONDO_SANDBOX_API_KEY=
ONDO_SANDBOX_API_SECRET=
ONDO_SANDBOX_ACCOUNT_ID=
# Ondo Perps PRODUCTION (mainnet), read-only only. `ondo_probe.py --mode production-readonly`
# reads exactly these three names and nothing else; the native adapter must name its own
# production variables the same way before this mode can authenticate. ONDO_MAINNET_ACCOUNT_ID
# is the venue's RAW accountID (not a Nautilus AccountId): the app validates it as a plain
# identifier and passes it unchanged to the native expected_venue_account_id, constructing the
# Nautilus AccountId it needs as ONDO-{raw}. The mode sets account_read_only and every
# write/DMS flag false, and it never falls back to the sandbox names above. Nothing here
# authorises a mainnet order: production authenticated writes remain refused by the adapter, and
# a real mainnet order still requires the user to say "上主网" in the current conversation. The
# app supplies its per-run diagnostics token internally; it is not another environment variable.
# An older wheel without production read-only or the confirmed diagnostics accessor is reported
# unsupported rather than treated as an account read.
ONDO_MAINNET_API_KEY=
ONDO_MAINNET_API_SECRET=
ONDO_MAINNET_ACCOUNT_ID=
# Optional: point the probe at the canonical .env instead of copying it into a worktree.
# Only a credentialed, non-dry-run session reads it; public/paper/--dry-run never do.
# ONDO_PROBE_ENV_FILE=E:\Nautilus-Perps\.env
