+            CAPABILITY_SOURCE_ADAPTER_ABSENT,
+            f"the installed Ondo adapter could not be loaded to read "
+            f"{NATIVE_SHUTDOWN_CAPABILITY_ATTRIBUTE} ({type(exc).__name__}): capability "
+            f"is unavailable rather than assumed",
+        )
+
