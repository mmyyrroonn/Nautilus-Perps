+    let written = journal_at(&journal).expect("the stop checkpointed");
+
+    assert!(
+        !written
+            .unsettled()
+            .iter()
+            .any(|entry| entry.client_order_id().to_string() == "ondo_refused"),
+        "no stale cancel registration for a never-rested order: {:?}",
+        written.unsettled(),
+    );
+}
